{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "terebi+ Design Tokens",
    "version": "1.1.0",
    "date": "2026-11-18",
    "basis": "960x540 dp (1920x1080 px @2x). 1 dp = 2 px bei 1080p, 4 px bei 2160p.",
    "owner": "ARJO LAB"
  },
  "color": {
    "ink": {
      "950": {
        "$type": "color",
        "$value": "#07080B",
        "$description": "Basis-Hintergrund, Scrim-Farbe, Text auf Fokus-Fläche"
      },
      "900": {
        "$type": "color",
        "$value": "#0E1014",
        "$description": "Glas-Tönung (Alpha 0.74 bis 0.84)"
      },
      "800": {
        "$type": "color",
        "$value": "#16181E",
        "$description": "Deckende Fläche: Einstellungen, Dialoge, Glas-Fallback"
      },
      "700": {
        "$type": "color",
        "$value": "#262A33",
        "$description": "Deaktivierte Fläche, Skeleton"
      }
    },
    "paper": {
      "50": {
        "$type": "color",
        "$value": "#F2F0EB",
        "$description": "Primärtext, Fokus-Fläche, Fokus-Ring. Warmweiss statt #FFFFFF"
      }
    },
    "signal": {
      "500": {
        "$type": "color",
        "$value": "#EF3E36",
        "$description": "Einziger Akzent: Logo-Punkt, Live-/Aktiv-Indikator, Fortschritt, Schalter AN. Nie als Textfarbe für Fliesstext, nie als Fläche > 24 dp."
      },
      "600": {
        "$type": "color",
        "$value": "#D2342D",
        "$description": "Signal gedrückt"
      }
    },
    "data": {
      "cool": {
        "$type": "color",
        "$value": "#8DB3E2",
        "$description": "Temperaturbalken kalt"
      },
      "warm": {
        "$type": "color",
        "$value": "#F0C27B",
        "$description": "Temperaturbalken warm"
      }
    },
    "state": {
      "success": {
        "$type": "color",
        "$value": "#5BC48A",
        "$description": "Verbunden, OK"
      },
      "warning": {
        "$type": "color",
        "$value": "#F0B44C",
        "$description": "Hinweis"
      },
      "error": {
        "$type": "color",
        "$value": "#FF6B61",
        "$description": "Fehlertext und -icon auf Dunkel (7.18:1 auf ink.950)"
      }
    },
    "role": {
      "background": {
        "$type": "color",
        "$value": "{color.ink.950}"
      },
      "textPrimary": {
        "$type": "color",
        "$value": "{color.paper.50}",
        "$description": "17.58:1 auf ink.950"
      },
      "textSecondary": {
        "$type": "color",
        "$value": "#F2F0EBB8",
        "$description": "paper 72 %; 9.13:1 auf ink.950; Minimum auf Foto/Glas"
      },
      "textTertiary": {
        "$type": "color",
        "$value": "#F2F0EB85",
        "$description": "paper 52 %; 5.13:1 auf ink.950; NUR auf deckenden Flächen"
      },
      "textDisabled": {
        "$type": "color",
        "$value": "#F2F0EB61",
        "$description": "paper 38 %; nur deaktiviert"
      },
      "onFocused": {
        "$type": "color",
        "$value": "{color.ink.950}",
        "$description": "17.58:1 auf paper.50"
      },
      "surfaceFocused": {
        "$type": "color",
        "$value": "{color.paper.50}"
      },
      "surfaceGlass": {
        "$type": "color",
        "$value": "#0E1014BD",
        "$description": "ink.900 74 % über weichgezeichnetem Hintergrund (Blur 24 dp). Adaptiv bis 84 %"
      },
      "surfaceGlassFocused": {
        "$type": "color",
        "$value": "#0E1014D6",
        "$description": "ink.900 84 %"
      },
      "hairline": {
        "$type": "color",
        "$value": "#F2F0EB29",
        "$description": "1 dp Kante oben 16 % bis unten 4 %"
      },
      "divider": {
        "$type": "color",
        "$value": "#F2F0EB1A",
        "$description": "10 %"
      },
      "track": {
        "$type": "color",
        "$value": "#F2F0EB1F",
        "$description": "12 %"
      },
      "focusRing": {
        "$type": "color",
        "$value": "{color.paper.50}"
      }
    }
  },
  "scrim": {
    "global": {
      "$type": "number",
      "$value": 0.16,
      "$description": "ink.950 vollflächig"
    },
    "left": {
      "$type": "gradient",
      "$value": [
        {
          "color": "#07080B",
          "alpha": 0.82,
          "position": 0.0
        },
        {
          "color": "#07080B",
          "alpha": 0.72,
          "position": 0.18
        },
        {
          "color": "#07080B",
          "alpha": 0.5,
          "position": 0.34
        },
        {
          "color": "#07080B",
          "alpha": 0.1,
          "position": 0.52
        },
        {
          "color": "#07080B",
          "alpha": 0.0,
          "position": 0.62
        }
      ],
      "$description": "horizontal, volle Breite"
    },
    "top": {
      "$type": "gradient",
      "$value": [
        {
          "color": "#07080B",
          "alpha": 0.84,
          "position": 0.0
        },
        {
          "color": "#07080B",
          "alpha": 0.56,
          "position": 0.5
        },
        {
          "color": "#07080B",
          "alpha": 0.0,
          "position": 1.0
        }
      ],
      "$description": "vertikal, Höhe 160 dp ab oben"
    },
    "bottom": {
      "$type": "gradient",
      "$value": [
        {
          "color": "#07080B",
          "alpha": 0.88,
          "position": 0.0
        },
        {
          "color": "#07080B",
          "alpha": 0.62,
          "position": 0.5
        },
        {
          "color": "#07080B",
          "alpha": 0.0,
          "position": 1.0
        }
      ],
      "$description": "vertikal, Höhe 200 dp ab unten (position 0 = unterer Rand)"
    },
    "right": {
      "$type": "gradient",
      "$value": [
        {
          "color": "#07080B",
          "alpha": 0.45,
          "position": 0.0
        },
        {
          "color": "#07080B",
          "alpha": 0.0,
          "position": 1.0
        }
      ],
      "$description": "horizontal von rechts, Breite 400 dp"
    },
    "minEffectiveBehindText": {
      "$type": "number",
      "$value": 0.69,
      "$description": "Effektive Abdunklung (alle Scrims kombiniert) hinter Primär-/Sekundärtext, gerechnet gegen reines Weiss"
    }
  },
  "typography": {
    "fontFamily": {
      "sans": {
        "$type": "fontFamily",

        "$type": "cubicBezier",
        "$value": [
          0.2,
          0.0,
          0.0,
          1.0
        ],
        "$description": "Material 3 standard"
      },
      "emphasizedDecelerate": {
        "$type": "cubicBezier",
        "$value": [
          0.05,
          0.7,
          0.1,
          1.0
        ],
        "$description": "Material 3 emphasized decelerate: Eintritt"
      },
      "emphasizedAccelerate": {
        "$type": "cubicBezier",
        "$value": [
          0.3,
          0.0,
          0.8,
          0.15

          "fontSize": "14sp",
          "lineHeight": "20sp",
          "fontWeight": 500,
          "letterSpacing": "0em",
          "fontFeature": "tnum"
        }
      },
      "labelMedium": {
        "$type": "typography",
        "$value": {
          "fontSize": "12sp",
          "lineHeight": "16sp",
          "fontWeight": 500,
          "letterSpacing": "0.01em"
        }
      },
      "overline": {
        "$type": "typography",
        "$value": {
          "fontSize": "12sp",
          "lineHeight": "16sp",
          "fontWeight": 600,
          "letterSpacing": "0.08em",
          "textTransform": "uppercase"
        }
      },
      "logo": {
        "$type": "typography",
        "$value": {
          "fontSize": "26sp",
          "lineHeight": "30sp",
          "fontWeight": 600,
          "letterSpacing": "-0.03em",
          "note": "nur als Vektor-Asset, nie live gesetzt"
        }
      }
